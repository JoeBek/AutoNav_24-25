<?xml version="1.0" ?>
<!--
  Fortress IGVC course — PARTIAL SCAFFOLD.

  This launches and demonstrates that `model://` resolution works against the
  installed custom_models (via IGN_GAZEBO_RESOURCE_PATH set in the launch file).
  It includes one of each road tile so the geometry loads.

  TWO things are intentionally NOT finished here (see README):
    1. LAYOUT: the Classic autonav_igvc_course.world stores 50+ tile/barrel
       poses in a 6000-line <state> dump. Those exact poses are not transcribed
       yet — the tiles below are placed on a simple grid as placeholders.
    2. TEXTURES: each road model.sdf uses a Classic Ogre <material><script>
       (name "vrc/course" etc.) that ign-rendering cannot load, so the painted
       lane lines will NOT appear until each model is converted to a Fortress
       PBR <material> with an <albedo_map> pointing at its texture PNG.
       Until then the tiles render untextured (grey), which is not usable for
       line detection.
-->
<sdf version="1.8">
  <world name="default">

    <plugin filename="ignition-gazebo-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="ignition-gazebo-navsat-system"
            name="gz::sim::systems::NavSat"/>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>200 200</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>200 200</size></plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Placeholder layout: one of each road tile on a grid. Replace poses
         with the real course layout and convert the materials (see header). -->
    <include>
      <uri>model://igvc_straightroad</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://igvc_curvedroad</uri>
      <pose>50 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://igvc_bendedroad</uri>
      <pose>-50 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://igvc_mirrorbendedroad</uri>
      <pose>0 50 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://igvc_potholeroad</uri>
      <pose>0 -50 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://road_big</uri>
      <pose>50 50 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://small_road</uri>
      <pose>-50 50 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://construction_barrel_resize</uri>
      <pose>5 0 0 0 0 0</pose>
    </include>


  </world>
</sdf>

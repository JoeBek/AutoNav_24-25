<?xml version="1.0" ?>
<!--
  straightland.world

  Boilerplate (plugins, physics, scene, ground plane, sun) taken from
  autonav_igvc_course.world. Asset layout (8x small_road tiles end-to-end
  along -Y with 3 construction barrels) taken from straight_1.sdf, but using
  portable model:// URIs resolved through IGN_GAZEBO_RESOURCE_PATH instead of
  hard-coded absolute install paths. The robot is NOT included here; it is
  spawned from /robot_description by launch_sim.launch.py.
-->
<sdf version="1.8">
  <world name="default">

    <plugin filename="ignition-gazebo-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="ignition-gazebo-navsat-system"
            name="gz::sim::systems::NavSat"/>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>200 200</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>200 200</size></plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Straight lane: 8 small_road tiles end-to-end along -Y (layout from straight_1.sdf). -->
    <include>
      <uri>model://small_road</uri>
      <name>small_road_1</name>
      <pose>0.829184 -0.700185 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://small_road</uri>
      <name>small_road_2</name>
      <pose>0.858313 -9.55949 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://small_road</uri>
      <name>small_road_3</name>
      <pose>0.850674 -18.7881 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://small_road</uri>
      <name>small_road_4</name>
      <pose>0.861967 -27.965 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://small_road</uri>
      <name>small_road_5</name>
      <pose>0.861967 -36.8866 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://small_road</uri>
      <name>small_road_6</name>
      <pose>0.831171 -46.1571 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://small_road</uri>
      <name>small_road_7</name>
      <pose>0.853759 -55.2382 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://small_road</uri>
      <name>small_road_8</name>
      <pose>0.851899 -64.2175 0 0 0 0</pose>
    </include>

    <!-- Construction barrel obstacles (layout from straight_1.sdf). -->
    <include>
      <uri>model://construction_barrel_resize</uri>
      <name>barrel_1</name>
      <pose>0.752526 -22.7167 0.005638 0 0 0</pose>
    </include>
    <include>
      <uri>model://construction_barrel_resize</uri>
      <name>barrel_2</name>
      <pose>1.04237 -35.7783 0.005393 0 0 0</pose>
    </include>
    <include>
      <uri>model://construction_barrel_resize</uri>
      <name>barrel_3</name>
      <pose>1.45049 -46.8169 0.00534 0 0 0</pose>
    </include>

  </world>
</sdf>

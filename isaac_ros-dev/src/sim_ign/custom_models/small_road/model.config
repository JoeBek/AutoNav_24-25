<?xml version="1.0"?>

<model>
  <name>Small Road</name>
  <version>1.0</version>
  <sdf version="1.5">model.sdf</sdf>

  <author>
    <name>Thomas Koletschka</name>
    <email>thomas.koletschka@gmail.com</email>
  </author>

  <description>
    Straight road tile rescaled to 9.42 m so its lane-line width matches the
    NARROWER line width of igvc_curvedroad (its vertical segments, 0.430 m;
    scale factor ~1.71x from the 5.5 m igvc_straightroad). Complements road_big,
    which matches the wider 0.545 m horizontal segments.
  </description>

</model>

<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="lidar_link">
    <inertial>
        <origin xyz="0 0 1" rpy="0 0 0"/>
        <mass value="0.125"/>
        <inertia ixx="0.001"  ixy="0"  ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>

    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
        <cylinder radius="0.0508" length="0.055"/>
        </geometry>
    </collision>

    <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
        <cylinder radius="0.0508" length="0.055"/>
        </geometry>
    </visual>
    </link>

    <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    </joint>

    <!-- Fortress gpu_lidar, 3D (16 rings). Rendered by the world-level
         sensors-system (ogre2). A multi-ring gpu_lidar publishes an
         ignition.msgs.PointCloudPacked on '<topic>/points' (here lidar/points)
         plus an ignition.msgs.LaserScan on '<topic>' (lidar). The cloud is
         bridged to /lidar/points in launch_sim.launch.py. -->
    <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <topic>lidar</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <lidar>
        <scan>
            <horizontal>
            <samples>360</samples>
            <resolution>1.000000</resolution>
            <min_angle>-3.141593</min_angle>
            <max_angle>3.141593</max_angle>
            </horizontal>
            <vertical>
            <samples>16</samples>
            <resolution>1.000000</resolution>
            <min_angle>-0.261799</min_angle>
            <max_angle>0.261799</max_angle>
            </vertical>
        </scan>
        <range>
            <min>0.120000</min>
            <max>30.0</max>
            <resolution>0.015000</resolution>
        </range>
        </lidar>
    </sensor>
    </gazebo>

</robot>

<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="gps_link">
    <inertial>
        <mass value="0.01"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
        <geometry>
        <box size="0.02 0.02 0.005"/>
        </geometry>
    </visual>
    </link>

    <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </joint>

    <!-- Classic 3rd-party libhector_gazebo_ros_gps.so -> Fortress built-in
         navsat sensor. The georeferencing that Hector took as plugin params
         (referenceLatitude/Longitude/Altitude) now lives in the WORLD's
         <spherical_coordinates> block, and the world must load
         ignition-gazebo-navsat-system. Published to 'navsat'; bridged to
         /gps/fix (sensor_msgs/NavSatFix). -->
    <gazebo reference="gps_link">
    <sensor name="navsat_sensor" type="navsat">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>navsat</topic>
        <gz_frame_id>gps_link</gz_frame_id>
    </sensor>
    </gazebo>

</robot>
